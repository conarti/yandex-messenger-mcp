{
  "name": "yandex-messenger-mcp",
  "version": "0.2.0",
  "description": "MCP server for Yandex Messenger (cookie/xiva transport)",
  "type": "module",
  "bin": {
    "yandex-messenger-mcp": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && cp src/config/reaction-map.json dist/config/reaction-map.json && chmod +x dist/index.js",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@cfworker/json-schema": "^4.1.1",
    "@modelcontextprotocol/sdk": "1.29.0",
    "playwright": "^1.61.1",
    "ws": "^8.21.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^12.0.9",
    "@semantic-release/npm": "^13.1.5",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@types/node": "^22.19.4",
    "@types/ws": "^8.18.1",
    "msgpackr": "^2.0.4",
    "semantic-release": "^25.0.8",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
